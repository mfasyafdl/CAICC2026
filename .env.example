# VisitPrep configuration.
# Copy this file to .env and adjust as needed. Never commit .env.

# Application metadata
APP_NAME=VisitPrep
APP_LANGUAGE=en
APP_VERSION=0.1.0

# Server / deployment (ModelScope Studio free CPU)
SERVER_NAME=0.0.0.0
PORT=7860
DEBUG=false

# Flow limits
MAX_FOLLOW_UP_QUESTIONS=5

# LLM — ModelScope OpenAI-compatible inference endpoint.
# core/llm.py reads these from server environment variables first, then from
# this local .env file. Never commit .env.
# MODELSCOPE_MODEL must be one of the four approved models; the default is
# zai-org/GLM-5.2. No local model downloads, training, or fine-tuning.
MODELSCOPE_API_KEY=
MODELSCOPE_MODEL=zai-org/GLM-5.2