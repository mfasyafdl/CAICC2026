# VisitPrep configuration.
# Copy this file to .env and adjust as needed. Never commit .env.

# Application metadata
APP_NAME=VisitPrep
APP_LANGUAGE=en
APP_VERSION=0.1.0

# Server / deployment (ModelScope Studio free CPU)
SERVER_NAME=0.0.0.0
PORT=7860
DEBUG=false

# Flow limits
MAX_FOLLOW_UP_QUESTIONS=5

# VisitPrep uses no API keys and performs no model downloads.